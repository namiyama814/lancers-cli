{
  "name": "lancers-cli",
  "version": "0.1.0",
  "description": "CLI and Cloudflare Workers MCP server for Lancers job search",
  "type": "module",
  "bin": {
    "lancers": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "lancers",
    "cli",
    "mcp",
    "cloudflare-workers",
    "freelance"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.26.0",
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.45.0"
  }
}
