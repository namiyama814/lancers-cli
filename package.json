{
  "name": "lancers-cli",
  "version": "0.1.0",
  "description": "CLI for searching and viewing Lancers job listings",
  "type": "module",
  "bin": {
    "lancers": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "lancers",
    "cli",
    "freelance"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.1.2",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
